---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtGallery from '../components/ArtGallery.astro';
import { getCollection } from 'astro:content';
import { t } from '../i18n/translations';

const lang = 'fr';

const products = await getCollection('products');

const items = products
  .filter((p) => p.data.lang === lang)
  .map((p) => ({
    title: p.data.title,
    description: p.data.description,
    cover: p.data.cover,
    slug: p.id,
    kind: p.data.category,
    price: p.data.price,
    currency: p.data.currency,
    sold: p.data.sold,
    dimensions: p.data.dimensions,
    framed: p.data.framed,
    date: p.data.date,
  }))
  .sort((a, b) => Number(a.sold) - Number(b.sold) || b.date.getTime() - a.date.getTime());

---

<BaseLayout title={`${t(lang, 'art.title')} — laura gregori`}>
  <ArtGallery lang={lang} items={items} />
</BaseLayout>
