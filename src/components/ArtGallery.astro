---
import ArtworkCard, { type Artwork } from './ArtworkCard.astro';
import ArtViewer from './ArtViewer.astro';
import { curateArtworks } from '../scripts/art-order.js';
import { t, type Lang } from '../i18n/translations';

interface Props { lang: Lang; items: Artwork[]; }
const { lang, items } = Astro.props;
const kinds = ['collage', 'pastel', 'watercolor'] as const;
const blocks = kinds.map((kind) => ({ kind, items: curateArtworks(items.filter((item) => item.kind === kind)) })).filter((block) => block.items.length);
---

<section class="px-6 md:px-10 py-16 md:py-24 max-w-7xl mx-auto">
  <header class="mb-16 md:mb-24">
    <h1 class="text-3xl md:text-5xl font-medium tracking-tight text-ink lowercase">{t(lang, 'art.title')}</h1>
    <p class="mt-4 text-sm text-earth">{t(lang, 'art.subtitle')}</p>
  </header>
  {blocks.map(({ kind, items: works }, index) => (
    <section id={`art-${kind}`} class:list={['art-block', index > 0 && 'mt-24 md:mt-36']}>
      <h2 class="mb-10 md:mb-14 flex items-baseline gap-4 text-xl font-medium lowercase">
        {t(lang, `art.section.${kind}`)}
        <span class="text-xs font-normal text-earth">{String(works.length).padStart(2, '0')}</span>
      </h2>
      <div class="art-gallery" data-gallery-kind={kind}>
        {works.map((item) => <ArtworkCard lang={lang} item={item} />)}
      </div>
    </section>
  ))}
</section>
<ArtViewer lang={lang} />

<script>
  if (window.location.hash) {
    requestAnimationFrame(() => {
      document.getElementById(window.location.hash.slice(1))?.scrollIntoView({ block: 'center' });
    });
  }
</script>
