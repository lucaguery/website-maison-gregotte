---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSplit from "../components/HeroSplit.astro";
import ArtEditorial from "../components/ArtEditorial.astro";
import { getCollection } from "astro:content";
import { t } from "../i18n/translations";
import heroImage from "../assets/images/collage-cortege.jpg";

const lang = "fr";

const products = await getCollection("products");

const items = products
  .filter((p) => p.data.lang === lang)
  .map((p) => ({
    title: p.data.title,
    description: p.data.description,
    cover: p.data.cover,
    slug: p.id,
    kind: p.data.category,
    price: p.data.price,
    currency: p.data.currency,
    sold: p.data.sold,
    date: p.data.date,
  }))
  // Collages lead, then unsold before sold, newest first.
  .sort((a, b) => Number(b.kind === 'collage') - Number(a.kind === 'collage') || Number(a.sold) - Number(b.sold) || b.date.getTime() - a.date.getTime());

const tagline =
  "peintures au pastel à l'huile et collages. des oeuvres où la couleur, la lumière et la matière occupent une place centrale.";
---

<BaseLayout>
  <HeroSplit
    lang={lang}
    title={t(lang, "hero.title")}
    tagline={tagline}
    heroImage={heroImage}
  />

  <ArtEditorial
    lang={lang}
    title={t(lang, "art.title")}
    subtitle={t(lang, "art.subtitle")}
    items={items}
  />
</BaseLayout>
