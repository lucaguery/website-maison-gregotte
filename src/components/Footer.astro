---
import { t } from '../i18n/translations';
import type { Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-sand/30 mt-auto">
  <div class="mx-auto max-w-7xl px-6 py-8 flex flex-col md:flex-row items-center justify-between gap-4">
    <p class="font-serif text-lg text-earth">maison gregotte</p>
    <p class="text-sm text-earth/70">
      &copy; {year} maison gregotte. {t(lang, 'footer.rights')}.
    </p>
  </div>
</footer>
