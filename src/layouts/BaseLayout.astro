---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, t } from '../i18n/translations';
import type { Lang } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  headerOverlay?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const {
  title = t(lang, 'hero.title'),
  description = t(lang, 'hero.subtitle'),
  bodyClass,
  headerOverlay = false,
} = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <noscript><style>.reveal-item { opacity: 1 !important; }</style></noscript>
  </head>
  <body class:list={['min-h-screen flex flex-col', bodyClass]}>
    <div class:list={[headerOverlay && 'header-overlay']}>
      <Header lang={lang} />
    </div>
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
