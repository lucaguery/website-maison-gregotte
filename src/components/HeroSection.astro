---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
  title: string;
  subtitle: string;
  heroImage: ImageMetadata;
}

const { lang, title, subtitle, heroImage } = Astro.props;
---

<section
  class="relative min-h-dvh flex flex-col items-center justify-center overflow-hidden"
  data-hero
>
  <!-- Parallax background image -->
  <Image
    src={heroImage}
    alt=""
    width={1920}
    height={1080}
    class="hero-parallax-img"
    data-parallax
    loading="eager"
  />

  <!-- Overlay -->
  <div class="absolute inset-0 bg-cream/60"></div>

  <!-- Content -->
  <div class="relative z-10 text-center px-6">
    <h1 class="text-2xl md:text-3xl font-light tracking-[0.3em] text-ink">
      {title}
    </h1>
    <p class="mt-3 text-base md:text-lg text-charcoal/80 tracking-wider font-medium">
      {subtitle}
    </p>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 scroll-indicator">
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      class="text-earth/60"
    >
      <path d="M12 5v14M19 12l-7 7-7-7" />
    </svg>
  </div>
</section>

<script>
  const hero = document.querySelector('[data-hero]');
  const img = document.querySelector<HTMLImageElement>('[data-parallax]');

  if (hero && img && window.matchMedia('(pointer: fine)').matches) {
    hero.addEventListener('mousemove', (e) => {
      const event = e as MouseEvent;
      const rect = hero.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width - 0.5;
      const y = (event.clientY - rect.top) / rect.height - 0.5;
      img.style.transform = `translate(${x * -20}px, ${y * -15}px) scale(1.05)`;
    });

    hero.addEventListener('mouseleave', () => {
      img.style.transform = 'translate(0, 0) scale(1.05)';
    });
  }
</script>
