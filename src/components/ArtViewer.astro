---
import { t, type Lang } from '../i18n/translations';
interface Props { lang: Lang; }
const { lang } = Astro.props;
---

<dialog class="art-viewer" aria-labelledby="art-viewer-title">
  <div class="viewer-shell">
    <header class="viewer-toolbar">
      <span class="text-xs text-earth tabular-nums" data-viewer-position aria-live="polite"></span>
      <button type="button" class="viewer-button" data-viewer-close autofocus>{t(lang, 'art.close')} <span aria-hidden="true">×</span></button>
    </header>
    <figure class="viewer-figure">
      <div class="viewer-image-wrap"><img data-viewer-image alt="" /></div>
      <figcaption class="viewer-caption">
        <div>
          <h2 id="art-viewer-title" class="text-lg md:text-xl font-medium lowercase" data-viewer-title></h2>
          <p class="mt-2 text-xs text-earth" data-viewer-details></p>
        </div>
        <p class="text-sm" data-viewer-status></p>
        <p class="viewer-description text-sm text-earth leading-relaxed" data-viewer-description></p>
      </figcaption>
    </figure>
    <nav class="viewer-navigation" aria-label={t(lang, 'art.navigation')}>
      <button type="button" class="viewer-button" data-viewer-previous><span aria-hidden="true">←</span> {t(lang, 'art.previous')}</button>
      <button type="button" class="viewer-button" data-viewer-next>{t(lang, 'art.next')} <span aria-hidden="true">→</span></button>
    </nav>
  </div>
</dialog>

<script>
  import { initArtworkViewer } from '../scripts/art-viewer.js';
  initArtworkViewer(document);
</script>
