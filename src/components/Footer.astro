---
import { t } from '../i18n/translations';
import type { Lang } from '../i18n/translations';
import Wordmark from './Wordmark.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-sand/30 mt-auto">
  <div class="mx-auto max-w-7xl px-6 py-8 flex flex-col md:flex-row items-center justify-between gap-4">
    <p class="text-lg text-earth">
      <Wordmark dot />
    </p>
    <p class="text-sm text-earth/70 text-center md:text-left">
      &copy; {year} <Wordmark class="align-baseline" />. {t(lang, 'footer.rights')}.
    </p>
  </div>
</footer>
