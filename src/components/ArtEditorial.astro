---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/translations';
import { getLocalizedPath, t } from '../i18n/translations';

type ArtKind = 'pastel' | 'watercolor' | 'collage';

interface Item {
  title: string;
  description: string;
  cover: ImageMetadata;
  slug: string;
  kind: ArtKind;
  price?: number;
  currency?: string;
  sold?: boolean;
}

interface Props {
  lang: Lang;
  title: string;
  subtitle?: string;
  items: Item[];
}

const { lang, title, subtitle, items } = Astro.props;
const shown = items.slice(0, 4);
const moreLabel = lang === 'fr' ? 'voir tout l\'art' : 'see all the art';
const slotClasses = ['mb-slot-1', 'mb-slot-2', 'mb-slot-3', 'mb-slot-4'];
// The lead work fills its slot; the rest stay smaller so the hierarchy holds.
const caps = ['md:max-h-[38rem]', 'md:max-h-[22rem]', 'md:max-h-[26rem]', 'md:max-h-[28rem]'];

const formatPrice = (price: number, currency: string) =>
  new Intl.NumberFormat(lang === 'fr' ? 'fr-FR' : 'en-GB', {
    style: 'currency',
    currency,
    maximumFractionDigits: 0,
  }).format(price);

const kindLabel = (kind: ArtKind) =>
  t(lang, `art.kind.${kind}` as const);
---

<section class="relative px-6 py-section max-w-7xl mx-auto">
  <header class="flex items-end justify-between mb-10 md:mb-14 gap-6">
    <div>
      <h2 class="text-3xl md:text-4xl font-medium tracking-tight text-ink lowercase">
        <span class="accent-tick"></span>{title}
      </h2>
      {subtitle && (
        <p class="mt-3 ml-8 text-sm md:text-base text-earth/80 max-w-md leading-relaxed">
          {subtitle}
        </p>
      )}
    </div>
    <a
      href={getLocalizedPath('/l-art', lang)}
      class="shrink-0 text-xs uppercase tracking-[0.3em] text-earth hover:text-terracotta border-b border-earth/30 hover:border-terracotta pb-1 transition-colors duration-500"
    >
      {moreLabel}
    </a>
  </header>

  <div class="editorial-grid">
    {shown.map((it, i) => (
      <article class={`group reveal-item ${slotClasses[i]}`}>
        <a href={getLocalizedPath('/l-art', lang) + '#' + it.slug} class="block">
          <div class="overflow-hidden bg-linen relative md:w-fit">
            <Image
              src={it.cover}
              alt={it.title}
              width={900}
              class:list={[`w-full h-auto md:w-auto md:max-w-full ${caps[i]}`, "transition-transform duration-[900ms] ease-out group-hover:scale-[1.03]"]}
            />
            {it.sold && (
              <span class="absolute top-3 left-3 text-[10px] uppercase tracking-[0.25em] bg-cream/90 text-terracotta px-2 py-1">
                {t(lang, 'shop.sold')}
              </span>
            )}
          </div>
          <div class="mt-3 flex items-baseline gap-3 flex-wrap">
            <span class="text-xs text-earth/60 tabular-nums">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="text-base md:text-lg text-ink lowercase tracking-tight">
              {it.title}
            </h3>
            <span class="text-[10px] uppercase tracking-[0.25em] text-earth/60 ml-auto">
              {kindLabel(it.kind)}
            </span>
          </div>
          <div class="mt-1 ml-8 flex items-baseline justify-between gap-4">
            <p class="text-sm text-earth/75 max-w-sm leading-relaxed line-clamp-2">
              {it.description}
            </p>
            {typeof it.price === 'number' && it.currency && (
              <p class="text-sm text-ink tabular-nums shrink-0">
                {it.sold ? '—' : formatPrice(it.price, it.currency)}
              </p>
            )}
          </div>
        </a>
      </article>
    ))}
  </div>
</section>

<script>
  const items = document.querySelectorAll('.editorial-grid .reveal-item');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const order = Array.from(el.parentElement?.children ?? []).indexOf(el);
            el.style.animationDelay = `${Math.max(0, order) * 100}ms`;
            el.classList.add('revealed');
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.12 }
    );
    items.forEach((item) => observer.observe(item));
  } else {
    items.forEach((item) => item.classList.add('revealed'));
  }
</script>
