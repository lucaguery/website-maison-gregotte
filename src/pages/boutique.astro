---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getCollection } from 'astro:content';
import { t } from '../i18n/translations';

const lang = 'fr';

const allProducts = (await getCollection('products'))
  .filter((entry) => entry.data.lang === lang)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const paintings = allProducts.filter((p) => p.data.category === 'painting');
const vintage = allProducts.filter((p) => p.data.category === 'vintage');
---

<BaseLayout title={`${t(lang, 'nav.shop')} — maison gregotte`}>
  <section class="px-6 py-section max-w-7xl mx-auto">
    <h1 class="text-4xl md:text-5xl font-serif text-ink mb-4">{t(lang, 'nav.shop')}</h1>
    <p class="text-earth mb-12 max-w-2xl">
      Pièces uniques à adopter — peintures originales et objets vintage chinés avec soin.
    </p>

    <!-- Paintings -->
    {paintings.length > 0 && (
      <div class="mb-section">
        <h2 class="text-2xl font-serif text-ink mb-6 border-b border-sand/30 pb-3">
          {t(lang, 'shop.paintings')}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-card">
          {paintings.map((entry) => (
            <ProductCard
              title={entry.data.title}
              description={entry.data.description}
              price={entry.data.price}
              currency={entry.data.currency}
              cover={entry.data.cover}
              sold={entry.data.sold}
              slug={entry.id}
              lang={lang}
            />
          ))}
        </div>
      </div>
    )}

    <!-- Vintage -->
    {vintage.length > 0 && (
      <div>
        <h2 class="text-2xl font-serif text-ink mb-6 border-b border-sand/30 pb-3">
          {t(lang, 'shop.vintage')}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-card">
          {vintage.map((entry) => (
            <ProductCard
              title={entry.data.title}
              description={entry.data.description}
              price={entry.data.price}
              currency={entry.data.currency}
              cover={entry.data.cover}
              sold={entry.data.sold}
              slug={entry.id}
              lang={lang}
            />
          ))}
        </div>
      </div>
    )}
  </section>
</BaseLayout>
