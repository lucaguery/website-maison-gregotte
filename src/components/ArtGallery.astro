---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/translations';

type ArtKind = 'pastel' | 'watercolor' | 'collage';

interface Item {
  title: string;
  description: string;
  cover: ImageMetadata;
  slug: string;
  kind: ArtKind;
  price?: number;
  currency?: string;
  sold?: boolean;
  dimensions?: string;
  framed?: boolean;
}

interface Props {
  lang: Lang;
  items: Item[];
}

const { lang, items } = Astro.props;

const filters = [
  { key: 'all', label: t(lang, 'art.filter.all') },
  { key: 'pastel', label: t(lang, 'art.filter.pastel') },
  { key: 'collage', label: t(lang, 'art.filter.collage') },
];

const formatPrice = (price: number, currency: string) =>
  new Intl.NumberFormat(lang === 'fr' ? 'fr-FR' : 'en-GB', {
    style: 'currency',
    currency,
    maximumFractionDigits: 0,
  }).format(price);

const kindLabel = (kind: ArtKind) => t(lang, `art.kind.${kind}` as const);

const pad = (n: number) => String(n).padStart(2, '0');

// Picture rail: four works per hairline, each resting on a shared baseline.
// Each image keeps its own proportions — a work is never cropped to fit a slot.
const PER_ROW = 4;

const rows = Array.from(
  { length: Math.ceil(items.length / PER_ROW) },
  (_, r) => items.slice(r * PER_ROW, r * PER_ROW + PER_ROW),
);
---

<section class="px-6 py-section max-w-7xl mx-auto">
  <header class="mb-10 md:mb-12">
    <h1 class="text-4xl md:text-6xl font-medium tracking-tight text-ink lowercase">
      <span class="accent-tick"></span>{t(lang, 'art.title')}
    </h1>
    <p class="mt-4 ml-8 text-base md:text-lg text-earth/85 max-w-xl leading-relaxed">
      {t(lang, 'art.subtitle')}
    </p>
  </header>

  <!-- Filter chips -->
  <div class="flex flex-wrap items-center gap-2 mb-10 md:mb-12" role="tablist">
    {filters.map((f) => (
      <button
        type="button"
        role="tab"
        data-filter={f.key}
        aria-selected={f.key === 'all'}
        class="art-filter-chip text-xs uppercase tracking-[0.25em] px-3 py-2 border border-earth/25 text-earth rounded-full transition-colors duration-300 hover:border-terracotta hover:text-terracotta"
      >
        {f.label}
      </button>
    ))}
    <span class="text-xs tracking-[0.25em] text-earth/50 ml-auto tabular-nums">
      <span id="art-count">{items.length}</span> / {items.length}
    </span>
  </div>

  <!-- Mixed gallery — each row hangs from a shared picture rail -->
  <div class="art-gallery grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-8 items-start">
    {rows.map((row, r) => (
      <Fragment>
        <div class:list={['art-rail col-span-full flex items-center gap-3', r > 0 && 'mt-6']}>
          <span class="art-rail-label text-[10px] uppercase tracking-[0.25em] text-earth/55 tabular-nums">
            {pad(r * PER_ROW + 1)} — {pad(r * PER_ROW + row.length)}
          </span>
          <span class="flex-1 h-px bg-sand/55"></span>
          <span class="w-5 h-px bg-terracotta"></span>
        </div>

        {row.map((it, j) => {
          const i = r * PER_ROW + j;

          return (
            <article
              id={it.slug}
              class="art-item group flex flex-col"
              data-kind={it.kind}
            >
              <div class="art-frame">
                <Image
                  src={it.cover}
                  alt={it.title}
                  width={900}
                  class="transition-transform duration-[900ms] ease-out group-hover:scale-[1.03]"
                />
              </div>
              <div class="mt-5 grid grid-cols-[auto_1fr] items-baseline gap-x-3">
                <span class="art-num text-xs text-earth/55 tabular-nums">{pad(i + 1)}</span>
                <h3 class="text-base md:text-lg text-ink lowercase tracking-tight">
                  {it.title}
                </h3>
              </div>
              <p class="mt-1.5 ml-8 text-[10px] uppercase tracking-[0.25em] text-earth/65">
                {[kindLabel(it.kind), it.dimensions, it.dimensions && it.framed && t(lang, 'art.framed')]
                  .filter(Boolean)
                  .join(' · ')}
              </p>
              <p class="mt-2 ml-8 text-sm text-earth/75 max-w-md leading-relaxed">
                {it.description}
              </p>
              {(typeof it.price === 'number' || it.sold) && (
                <p class="mt-3 ml-8 flex items-center gap-3 text-sm text-ink tabular-nums">
                  {typeof it.price === 'number' && it.currency && formatPrice(it.price, it.currency)}
                  {it.sold && (
                    <span class="text-[10px] uppercase tracking-[0.2em] text-terracotta border border-terracotta/40 px-1.5 py-0.5">
                      {t(lang, 'shop.sold')}
                    </span>
                  )}
                </p>
              )}
            </article>
          );
        })}
      </Fragment>
    ))}
  </div>

  <p class="art-empty hidden mt-20 text-center text-sm text-earth/60 uppercase tracking-[0.3em]">
    —
  </p>
</section>

<script>
  const PER_ROW = 4;
  const chips = document.querySelectorAll<HTMLButtonElement>('.art-filter-chip');
  const items = Array.from(document.querySelectorAll<HTMLElement>('.art-item'));
  const rails = Array.from(document.querySelectorAll<HTMLElement>('.art-rail'));
  const countEl = document.getElementById('art-count');
  const emptyEl = document.querySelector<HTMLElement>('.art-empty');

  const pad = (n: number) => String(n).padStart(2, '0');

  // Filtering reflows the rows, so rails and numbering are re-derived from the
  // visible set and re-ordered with `order` rather than left where they were.
  const applyFilter = (key: string) => {
    const visible = items.filter((el) => key === 'all' || el.dataset.kind === key);
    const shown = new Set(visible);
    items.forEach((el) => {
      el.style.display = shown.has(el) ? '' : 'none';
    });

    let order = 0;
    rails.forEach((rail, r) => {
      const row = visible.slice(r * PER_ROW, r * PER_ROW + PER_ROW);
      if (row.length === 0) {
        rail.style.display = 'none';
        return;
      }
      rail.style.display = '';
      rail.style.order = String(++order);
      const label = rail.querySelector('.art-rail-label');
      if (label) {
        label.textContent = `${pad(r * PER_ROW + 1)} — ${pad(r * PER_ROW + row.length)}`;
      }
      row.forEach((el, j) => {
        el.style.order = String(++order);
        const num = el.querySelector('.art-num');
        if (num) num.textContent = pad(r * PER_ROW + j + 1);
      });
    });

    if (countEl) countEl.textContent = String(visible.length);
    if (emptyEl) emptyEl.classList.toggle('hidden', visible.length > 0);
  };

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const key = chip.dataset.filter || 'all';
      chips.forEach((c) => {
        const active = c === chip;
        c.setAttribute('aria-selected', String(active));
        c.classList.toggle('bg-ink', active);
        c.classList.toggle('text-cream', active);
        c.classList.toggle('border-ink', active);
        c.classList.toggle('text-earth', !active);
      });
      applyFilter(key);
    });
  });

  // Activate initial state
  const initial = document.querySelector<HTMLButtonElement>('.art-filter-chip[aria-selected="true"]');
  if (initial) {
    initial.classList.add('bg-ink', 'text-cream', 'border-ink');
    initial.classList.remove('text-earth');
  }

  // If URL has hash, scroll smoothly to matching item on load
  if (window.location.hash) {
    requestAnimationFrame(() => {
      const target = document.querySelector(window.location.hash);
      target?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  }
</script>
