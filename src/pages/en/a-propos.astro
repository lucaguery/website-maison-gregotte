---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { t } from '../../i18n/translations';
import portraitImg from '../../assets/images/portrait-laura.jpg';

const lang = 'en';
---

<BaseLayout title={`${t(lang, 'nav.about')} — laura gregori`}>
  <section class="px-6 py-section max-w-5xl mx-auto">
    <h1 class="text-4xl md:text-5xl font-serif text-ink mb-4">{t(lang, 'about.title')}</h1>
    <p class="text-earth mb-12">{t(lang, 'about.subtitle')}</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
      <!-- Portrait -->
      <div class="overflow-hidden rounded-sm bg-linen">
        <Image
          src={portraitImg}
          alt="laura gregori in the vineyards"
          width={800}
          class="w-full h-auto"
        />
      </div>

      <!-- Bio -->
      <div class="space-y-6 text-ink/85 leading-relaxed">
        <p>laura gregori is a young artist based in Paris.</p>
        <p>
          She works mainly in oil pastel and collage.
        </p>
        <p>
          She likes moving from one technique to another, exploring their
          materials and possibilities, and finding for each inspiration the way
          that fits it.
        </p>
        <p>Every piece is made by hand, in her Paris studio.</p>
      </div>
    </div>
  </section>
</BaseLayout>
