---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { t } from "../i18n/translations";
import portraitImg from "../assets/images/portrait-laura.jpg";

const lang = "fr";
---

<BaseLayout title={`${t(lang, "nav.about")} — laura gregori`}>
  <section class="px-6 py-section max-w-5xl mx-auto">
    <h1 class="text-4xl md:text-5xl font-serif text-ink mb-4">
      {t(lang, "about.title")}
    </h1>
    <p class="text-earth mb-12">{t(lang, "about.subtitle")}</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
      <!-- Portrait -->
      <div class="overflow-hidden rounded-sm bg-linen">
        <Image
          src={portraitImg}
          alt="laura gregori dans les vignes"
          width={800}
          class="w-full h-auto"
        />
      </div>

      <!-- Bio -->
      <div class="space-y-6 text-ink/85 leading-relaxed">
        <p>Laura Gregori est une jeune artiste basée à Paris.</p>
        <p>
          Elle travaille principalement le pastel à l'huile, le collage et
          l'aquarelle.
        </p>
        <p>
          Elle aime passer d'une technique à une autre, explorer leurs matières
          et leurs possibilités et trouver pour chaque inspiration la manière qui
          lui correspond.
        </p>
        <p>Chaque oeuvre est réalisée à la main, dans son atelier à Paris.</p>
      </div>
    </div>
  </section>
</BaseLayout>
