---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/translations';

const lang = 'en';
---

<BaseLayout title={`${t(lang, 'nav.contact')} — laura gregori`}>
  <section class="px-6 py-section max-w-7xl mx-auto">
    <header class="mb-10 md:mb-14">
      <h1 class="text-4xl md:text-6xl font-medium tracking-tight text-ink lowercase">
        <span class="accent-tick"></span>{t(lang, 'contact.title')}
      </h1>
      <p class="mt-4 ml-8 text-base md:text-lg text-earth/85 max-w-xl leading-relaxed">{t(lang, 'contact.subtitle')}</p>
    </header>

    <div class="ml-0 md:ml-8 grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-6">
      <!-- Contact form -->
      <form class="md:col-span-6 lg:col-span-5 space-y-6" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="bfdbd02f-fcf3-4e61-ae97-5a5f32f8af62" />
        <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />
        <div>
          <label for="name" class="block text-sm text-earth mb-2">{t(lang, 'contact.name')}</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full border border-sand/50 bg-transparent px-4 py-3 text-sm text-ink placeholder:text-earth/40 focus:border-earth focus:outline-none rounded-sm"
            placeholder="Your name"
          />
        </div>
        <div>
          <label for="email" class="block text-sm text-earth mb-2">{t(lang, 'contact.email')}</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full border border-sand/50 bg-transparent px-4 py-3 text-sm text-ink placeholder:text-earth/40 focus:border-earth focus:outline-none rounded-sm"
            placeholder="your@email.com"
          />
        </div>
        <div>
          <label for="message" class="block text-sm text-earth mb-2">{t(lang, 'contact.message')}</label>
          <textarea
            id="message"
            name="message"
            rows="6"
            required
            class="w-full border border-sand/50 bg-transparent px-4 py-3 text-sm text-ink placeholder:text-earth/40 focus:border-earth focus:outline-none rounded-sm resize-none"
            placeholder="Your message..."
          ></textarea>
        </div>
        <button
          type="submit"
          class="bg-ink text-cream px-8 py-3 text-sm uppercase tracking-widest hover:bg-charcoal transition-colors rounded-sm"
        >
          {t(lang, 'contact.send')}
        </button>
      </form>

      <!-- Contact info -->
      <div class="md:col-span-5 md:col-start-8 space-y-8">
        <div>
          <h3 class="font-serif text-lg text-ink mb-3">Get in touch</h3>
          <ul class="space-y-3 text-sm text-earth">
            <li><a href="mailto:lauragregori.art@gmail.com" class="hover:text-ink transition-colors">lauragregori.art@gmail.com</a></li>
          </ul>
        </div>

        <div>
          <h3 class="font-serif text-lg text-ink mb-3">Follow me</h3>
          <ul class="space-y-2 text-sm">
            <li>
              <a href="https://www.instagram.com/lauragregori.art/" class="text-earth hover:text-ink transition-colors">Instagram</a>
            </li>
            <li>
              <a href="https://www.pinterest.com/lauragregoriart/" class="text-earth hover:text-ink transition-colors">Pinterest</a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
