---
import ArtworkCard, { type Artwork } from './ArtworkCard.astro';
import ArtViewer from './ArtViewer.astro';
import { curateArtworks } from '../scripts/art-order.js';
import { getLocalizedPath, type Lang } from '../i18n/translations';

interface Props { lang: Lang; title: string; subtitle?: string; items: Artwork[]; }
const { lang, title, subtitle, items } = Astro.props;
const shown = curateArtworks(items).slice(0, 4);
const moreLabel = lang === 'fr' ? `voir les ${items.length} œuvres` : `see all ${items.length} works`;
---

<section class="px-6 md:px-10 py-20 md:py-28 max-w-7xl mx-auto">
  <header class="mb-12 md:mb-16 flex flex-wrap items-end justify-between gap-6">
    <div>
      <h2 class="text-2xl md:text-3xl font-medium tracking-tight lowercase">{title}</h2>
      {subtitle && <p class="mt-3 text-sm text-earth">{subtitle}</p>}
    </div>
    <a href={getLocalizedPath('/l-art', lang)} class="text-xs text-earth border-b border-earth/40 pb-1 hover:text-ink">{moreLabel} →</a>
  </header>
  <div class="art-gallery">
    {shown.map((item) => <ArtworkCard lang={lang} item={item} />)}
  </div>
  <div class="mt-16 text-center">
    <a href={getLocalizedPath('/l-art', lang)} class="inline-block border-b border-ink/40 pb-2 text-sm hover:text-terracotta">{moreLabel} →</a>
  </div>
</section>
<ArtViewer lang={lang} />
