---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/HeroSection.astro';
import MoodboardCarousel from '../../components/MoodboardCarousel.astro';
import ProductMasonry from '../../components/ProductMasonry.astro';
import { getCollection } from 'astro:content';
import { t } from '../../i18n/translations';
import heroImage from '../../assets/images/hero.jpg';

const lang = 'en';

const moodboards = (await getCollection('moodboards'))
  .filter((entry) => entry.data.lang === lang)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const products = (await getCollection('products'))
  .filter((entry) => entry.data.lang === lang)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 8);
---

<BaseLayout bodyClass="overflow-hidden" headerOverlay>
  <div class="gallery-wall">
    <HeroSection
      lang={lang}
      title={t(lang, 'hero.title')}
      subtitle={t(lang, 'hero.subtitle')}
      heroImage={heroImage}
    />

    <MoodboardCarousel
      lang={lang}
      title={t(lang, 'nav.moodboards')}
      moodboards={moodboards.map((entry) => ({
        title: entry.data.title,
        description: entry.data.description,
        cover: entry.data.cover,
        slug: entry.id,
      }))}
    />

    <ProductMasonry
      lang={lang}
      title={t(lang, 'nav.shop')}
      products={products.map((entry) => ({
        title: entry.data.title,
        description: entry.data.description,
        price: entry.data.price,
        currency: entry.data.currency,
        cover: entry.data.cover,
        sold: entry.data.sold,
        slug: entry.id,
      }))}
    />
  </div>
</BaseLayout>
